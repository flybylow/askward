# Server-only — never expose to the browser
ELEVENLABS_API_KEY=

# Public — used by the browser to identify the agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# WhatsApp escape hatch — phone + intro line; conversation history is appended at runtime:
# NEXT_PUBLIC_WHATSAPP_PHONE=32471353104
# NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi Ward — I had a question from Ask Ward
# Or set NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/32471353104 (phone only — history still appended)
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_WHATSAPP_PHONE=
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# Set to 1 to show nav/tool debug HUD in production builds
# NEXT_PUBLIC_DEBUG_NAV=1
